# Telegram bot token from @BotFather, added as admin to your Good News Ethiopia channel
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenGoesHere

# The channel the bot posts to (must be an admin there) — @username or numeric chat id
TARGET_CHAT=@good_news_ethiopia

# Optional: your personal Telegram chat id. If set, the bot DMs you when a run
# crashes. Get yours by messaging the bot once, then checking getUpdates.
ADMIN_CHAT_ID=

# Gemini API key, from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Comma-separated Tikvah Telegram handles to scrape (no @, just the username part of t.me/<handle>)
SOURCE_CHANNELS=tikvahethiopia,tikvahethmagazine

# Optional overrides
GEMINI_MODEL=gemini-flash-lite-latest
MAX_MESSAGES_PER_RUN=20
BATCH_SIZE=5
